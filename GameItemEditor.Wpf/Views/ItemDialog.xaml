<Window x:Class="GameItemEditor.Wpf.Views.ItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:GameItemEditor.Core.Enums;assembly=GameItemEditor.Core"
        xmlns:converters="clr-namespace:GameItemEditor.Wpf.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" 
        Height="550" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinHeight="500"
        MinWidth="450">

    <Window.Resources>
        <!-- Конвертер для видимости -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Стиль для полей с ошибками -->
        <Style TargetType="TextBox" x:Key="ErrorTextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.HasError)}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для заголовков -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Название -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" Style="{StaticResource LabelStyle}"/>
        <TextBox Grid.Row="0" Grid.Column="1" 
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                 Style="{StaticResource ErrorTextBox}"/>

        <!-- Тип -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип:" Style="{StaticResource LabelStyle}"/>
        <ComboBox Grid.Row="1" Grid.Column="1" 
                  ItemsSource="{Binding ItemTypes}"
                  SelectedItem="{Binding Type}"
                  Margin="0,3"/>

        <!-- Редкость -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Редкость:" Style="{StaticResource LabelStyle}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" 
                  ItemsSource="{Binding ItemRarities}"
                  SelectedItem="{Binding Rarity}"
                  Margin="0,3"/>

        <!-- Цена -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Цена:" Style="{StaticResource LabelStyle}"/>
        <TextBox Grid.Row="3" Grid.Column="1" 
                 Text="{Binding BasePrice, UpdateSourceTrigger=PropertyChanged}" 
                 Style="{StaticResource ErrorTextBox}"/>

        <!-- Вес -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Вес:" Style="{StaticResource LabelStyle}"/>
        <TextBox Grid.Row="4" Grid.Column="1" 
                 Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" 
                 Style="{StaticResource ErrorTextBox}"/>

        <!-- Свойства (заглушка) -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Свойства:" Style="{StaticResource LabelStyle}" 
                   VerticalAlignment="Top" Margin="0,8,0,3"/>
        <Border Grid.Row="5" Grid.Column="1" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                CornerRadius="5" 
                Margin="0,8,0,3" 
                Padding="10" 
                MinHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="Свойства для этого типа предмета будут отображаться здесь" 
                           TextWrapping="Wrap" 
                           Foreground="Gray" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="{Binding SaveButtonText}" 
                    Command="{Binding SaveCommand}" 
                    Width="100" 
                    Height="30" 
                    Margin="0,0,10,0"
                    IsDefault="True"/>
            <Button Content="Отмена" 
                    Command="{Binding CancelCommand}" 
                    Width="100" 
                    Height="30"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>